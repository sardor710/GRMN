# Local examples only. Set distinct runtime and DDL-role credentials before deployment.
# The application does not read these until the DB adapter is explicitly called.
DATABASE_URL=postgresql://grmn_local:replace_local_password@127.0.0.1:55432/grmn_local
DATABASE_MIGRATION_URL=postgresql://grmn_local:replace_local_password@127.0.0.1:55432/grmn_local
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# Optional Compose development service; not used by the disposable integration suite.
GRMN_LOCAL_DB_PASSWORD=replace_local_password

# Auth is disabled by default. Never expose these through NEXT_PUBLIC variables.
AUTH_ENABLED=0
# Use a random 32-byte secret encoded as exactly 64 hex characters; no default.
# AUTH_SECRET=
# AUTH_BASE_URL=http://localhost:3000
# Production requires this exact header, replaced by the trusted TLS proxy.
# AUTH_TRUSTED_IP_HEADER=x-grmn-client-ip
# One-time local operator command only; leave disabled outside that invocation.
AUTH_BOOTSTRAP_ENABLED=0

# Explicit CMS source. Keep legacy until a reviewed cutover; postgres never falls back.
CMS_BACKEND=legacy

# Staff order alerts over the WhatsApp Cloud API. Leave all WHATSAPP_* unset to disable.
# Both the Next.js app (queues alerts) and the outbox worker (sends them) read these.
# Setup: docs/backend/whatsapp-order-alerts.md
# Permanent System User token. Never expose it through a NEXT_PUBLIC variable.
# WHATSAPP_ACCESS_TOKEN=
# The sender number ID from WhatsApp Manager (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# Staff numbers in international format, comma-separated, at most 10.
# WHATSAPP_NOTIFY_TO=77011234567,77017654321
# WHATSAPP_TEMPLATE_NAME=order_alert
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v23.0
