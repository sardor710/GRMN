# Local examples only. Set distinct runtime and DDL-role credentials before deployment.
# The application does not read these until the DB adapter is explicitly called.
DATABASE_URL=postgresql://grmn_local:replace_local_password@127.0.0.1:55432/grmn_local
DATABASE_MIGRATION_URL=postgresql://grmn_local:replace_local_password@127.0.0.1:55432/grmn_local
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# Optional: concurrent catalog listings per process (default half the pool) and their wait before 503.
# CATALOG_LISTING_CONCURRENCY=2
# CATALOG_LISTING_WAIT_MS=2000

# Optional Compose development service; not used by the disposable integration suite.
GRMN_LOCAL_DB_PASSWORD=replace_local_password

# Auth is disabled by default. Never expose these through NEXT_PUBLIC variables.
AUTH_ENABLED=0
# Use a random 32-byte secret encoded as exactly 64 hex characters; no default.
# AUTH_SECRET=
# AUTH_BASE_URL=http://localhost:3000
# Production requires this exact header, replaced by the trusted TLS proxy.
# AUTH_TRUSTED_IP_HEADER=x-grmn-client-ip
# One-time local operator command only; leave disabled outside that invocation.
AUTH_BOOTSTRAP_ENABLED=0

# Explicit CMS source. Keep legacy until a reviewed cutover; postgres never falls back.
CMS_BACKEND=legacy

# Demo checkout (Settings -> Payments, on by default until launch): 1 forces it off on this server,
# so checkout offers only manual payment. Leave empty to follow the admin setting.
DEMO_CHECKOUT_DISABLED=

# Demo orders allowed per customer or guest session, and per client address, in 24 h (default 5).
# Accepted: a whole number from 0 to 1000000 (0 = unlimited; empty = 5). Anything else (negative,
# fractional, not a number, above 1000000) falls back to 5 with a warning in the log.
# Signed-in staff are never capped, and their demo orders do not count toward an address's limit.
DEMO_ORDER_LIMIT=

# Demo purchases (D03a): 1 registers the sandbox adapter, so "Demo checkout" orders are captured at once
# and shown as Paid (Demo). Refused with NODE_ENV=production unless DEMO_PURCHASES_ALLOW_PRODUCTION=1,
# and then only signed-in staff may demo-buy (real stock and coupons are consumed).
DEMO_PURCHASES=
DEMO_PURCHASES_ALLOW_PRODUCTION=
# 1 = with the production override, every shopper (not only staff) may demo-buy, capped by DEMO_ORDER_LIMIT.
DEMO_PURCHASES_PUBLIC=

# Staff order alerts over the WhatsApp Cloud API. Leave all WHATSAPP_* unset to disable.
# Both the Next.js app (queues alerts) and the outbox worker (sends them) read these.
# Setup: docs/backend/whatsapp-order-alerts.md
# Permanent System User token. Never expose it through a NEXT_PUBLIC variable.
# WHATSAPP_ACCESS_TOKEN=
# The sender number ID from WhatsApp Manager (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# Staff numbers in international format, comma-separated, at most 10.
# WHATSAPP_NOTIFY_TO=77011234567,77017654321
# WHATSAPP_TEMPLATE_NAME=order_alert
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v23.0

# Yandex Maps (address form, M8). Restrict both keys by HTTP referrer in the Yandex developer console.
# JavaScript API 2.1 key: public by design (sent to the browser to load the map).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# HTTP Geocoder key: used only by the server route /api/geo/geocode. YANDEX_GEOCODER_API_KEY is
# preferred (never bundled); NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY is accepted as a fallback.
YANDEX_GEOCODER_API_KEY=
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=
