# deploy/compose.yml settings. Copy to a private file outside the repository (chmod 600), one per
# environment, and pass it with --env-file. Generate each secret separately, e.g. `openssl rand -hex 32`.
GRMN_DOMAIN=shop.example.kz
APP_IMAGE=grmn:<commit>
OPS_IMAGE=grmn-ops:<commit>
CMS_BACKEND=postgres
MAINTENANCE_MODE=0
AUTH_SECRET=<64 hex characters>
DB_OWNER_PASSWORD=<secret>
DB_MIGRATE_PASSWORD=<secret>
DB_APP_PASSWORD=<secret>
# Backups: a host directory (staging) or a mounted off-host target (production; see deploy/README.md).
BACKUP_DIR=/srv/grmn/backup
TLS_DIR=/srv/grmn/tls
OPS_TEMP_DIR=/srv/grmn/ops-temp
# 127.0.0.1 for staging; the public address (or 0.0.0.0) only for production.
PROXY_BIND=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80
# Backups kept this many days (never fewer than the newest 2 base backups).
KEEP_DAYS=14
# Alerts (deploy/ops/notify.sh): the owner's Telegram bot and group. Leave empty until set up; alerts
# are then only written to /var/log/grmn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Staff sign-in: 1 (default) requires an authenticator app (TOTP); 0 = password only.
STAFF_MFA_REQUIRED=1
# Admin "Auto-translate RU & KZ" (OpenRouter). Empty key: the button reports it is not configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
