# Task 23 G4: production TLS proxy (plan Section 11). The trusted client address is the TCP peer
# ($remote_addr) and always overwrites any client-supplied x-grmn-client-ip. If a CDN or load balancer
# is put in front, configure ngx_http_realip_module for its address ranges first; never trust a
# forwarded header from the open internet.
# A front door on the same host (Task 24: the shared edge nginx) is trusted for X-Real-IP from
# GRMN_TRUSTED_PROXY only (default 127.0.0.1/32, which trusts nobody in practice).
set_real_ip_from ${GRMN_TRUSTED_PROXY};
real_ip_header X-Real-IP;
upstream grmn_app { server app:3000; keepalive 32; }
server {
  listen 80;
  server_name ${GRMN_DOMAIN};
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  http2 on;
  server_name ${GRMN_DOMAIN};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 25m;
  location / {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header x-grmn-client-ip $remote_addr;
    proxy_read_timeout 60s;
    proxy_pass http://grmn_app;
  }
}
# Any other Host gets nothing (no default-site leakage).
server {
  listen 443 ssl default_server;
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  return 444;
}
