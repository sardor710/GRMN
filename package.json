{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:unit": "node --conditions=react-server --test tests/unit/*.test.mjs",
    "test:cms-ui": "node --conditions=react-server tests/ui/cms-smoke.mjs",
    "test:integration": "node --conditions=react-server --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test": "npm run test:legacy && npm run test:unit && npm run test:integration && npm run check:boundaries",
    "check:boundaries": "node scripts/check-server-boundaries.mjs",
    "auth:bootstrap": "node --env-file-if-exists=.env.local --conditions=react-server scripts/auth/bootstrap.mjs",
    "db:import:dry-run": "node --conditions=react-server scripts/migration/dry-run.ts",
    "db:import:rehearse": "node --conditions=react-server scripts/migration/rehearse.ts",
    "db:import:target": "node --conditions=react-server scripts/migration/import-target.ts",
    "db:generate": "node --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server node_modules/drizzle-kit/bin.cjs migrate",
    "db:local:up": "docker compose --env-file .env.local -f compose.backend.yml up -d db",
    "db:local:stop": "docker compose --env-file .env.local -f compose.backend.yml stop db",
    "worker": "node --conditions=react-server scripts/workers/outbox-worker.mjs",
    "ops:store-setup": "node --conditions=react-server scripts/ops/store-setup.ts",
    "ops:health": "node --conditions=react-server scripts/ops/health-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/drizzle-adapter": "1.7.19",
    "better-auth": "1.7.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "htmlparser2": "^12.0.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.2",
    "server-only": "0.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
